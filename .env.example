# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Used exclusively by `npm run seed`. Never used by the web app or agent.
SUPABASE_SECRET_KEY=

# LiveKit Cloud (Project Settings). Server-only; never prefix with NEXT_PUBLIC_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email (optional). Only read by `npm run email:setup`, which stores the key in Supabase Vault.
# The web app and agent never see it. Get a key at https://resend.com (the free sandbox sender works for demos).
RESEND_API_KEY=
# Optional sender, e.g. "FlowCRM <hello@yourdomain.com>" (needs a domain verified in Resend).
# Leave empty to use the sandbox sender, which can only email your own Resend account address.
EMAIL_FROM=
